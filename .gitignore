# .gitignore — deribit_vrp (crypto VRP research: BTC option/underlying data audit and cleaning)
#
# data/ is ignored as a whole: data/raw/ holds read-only vendor files, and data/audit/ and
# data/processed/ are regenerated by scripts/run_audit.py and scripts/build_panel.py.
# archive/ holds local backups of earlier outputs, used only for regression checks.

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/

# --- macOS / Windows ---
.DS_Store
Thumbs.db

# --- Editors & tooling ---
.vscode/
.idea/
.claude/

data/

# --- Local backups for regression checks ---
archive/
